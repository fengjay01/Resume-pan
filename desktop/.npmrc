# electron-builder 打包阶段需要下载 Electron 二进制与 winCodeSign / NSIS 工具，
# 官方 GitHub Releases 在国内常被代理拦截（502）。CI 上可用同名环境变量覆盖为官方源。
electron_mirror=https://repo.huaweicloud.com/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 【绝不写 C 盘】手动执行 npm install / npx 时的兜底缓存位置（相对 desktop/）。
# tools/pack-release.mjs 会用绝对路径环境变量覆盖，保证任何 cwd 下都落在项目内。
cache=./.build-env/cache/npm
tmp=./.build-env/tmp
