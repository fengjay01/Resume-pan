{
  "name": "resume-pan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Resume-Pan - 面向技术从业者的免费在线简历制作工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "test": "npm run test:render && npm run test:entry && npm run test:import",
    "test:render": "node ../tools/run-ts.mjs ../tools/tests/test-render.tsx",
    "test:entry": "node ../tools/run-ts.mjs ../tools/tests/test-entry.ts",
    "test:import": "node ../tools/run-ts.mjs ../tools/tests/test-import.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.451.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "misans": "^5.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.21.5",
    "@rollup/rollup-win32-x64-msvc": "^4.64.2"
  }
}
